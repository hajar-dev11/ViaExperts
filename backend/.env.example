APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Frontend SPA / sous-domaines --------------------------------------------
# En local : adresse du serveur Vite (ex. http://localhost:5173).
# En production : l'URL HTTPS réelle du frontend (ex. https://app.exemple.com).
# Utilisée pour le lien de réinitialisation de mot de passe et pour la liste
# blanche CORS ci-dessous.
FRONTEND_URL=http://localhost:5173

# Domaines autorisés à recevoir le cookie de session Sanctum (SPA stateful).
# Liste séparée par des virgules, SANS schéma (http/https) ni chemin.
# En local : les ports de dev. En production : le(s) domaine(s) du frontend,
# ex. app.exemple.com (et api.exemple.com si l'API répond depuis le même host).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Domaine du cookie de session.
# En local : laisser vide ou "localhost".
# En production, si frontend et API sont des sous-domaines d'un même domaine
# racine (ex. app.exemple.com + api.exemple.com) : utiliser ".exemple.com"
# (point en tête) pour que le cookie soit visible des deux côtés.
SESSION_DOMAIN=localhost

# Cookie de session envoyé uniquement en HTTPS.
# En local (HTTP) : false. En production (HTTPS) : true, obligatoire.
SESSION_SECURE_COOKIE=false

# Comportement cross-site du cookie de session (lax / strict / none).
# "lax" convient tant que frontend et API restent sur le même domaine racine.
# Si frontend et API finissent sur deux domaines réellement différents (pas de
# domaine racine commun), passer à "none" (impose alors SESSION_SECURE_COOKIE=true).
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
