# Modèle de backend/.env.testing — environnement des tests PHPUnit (php artisan test).
# Copier en .env.testing (fichier ignoré par Git), puis renseigner APP_KEY et le mot de passe de la base de TEST.
#
# ATTENTION : DB_DATABASE doit être une base JETABLE dédiée aux tests (créée vide : utf8mb4 / utf8mb4_unicode_ci).
# Les tests la vident et la recréent (RefreshDatabase) : ne JAMAIS y mettre la base de développement ou de production.
#   CREATE DATABASE via_expert_app_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# APP_KEY : php artisan key:generate --env=testing

APP_NAME="Via Experts"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=via_expert_app_test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:5180,127.0.0.1:5180
SESSION_DOMAIN=localhost

MAIL_MAILER=array