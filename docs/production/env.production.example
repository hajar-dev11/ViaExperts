# Modèle de .env de PRODUCTION pour backend/.env — À COPIER SUR LE SERVEUR et à remplir.
# Ce fichier ne contient AUCUN secret : ne jamais y écrire de vraies valeurs, ne jamais commiter le vrai .env.
# Voir docs/production/CONFIGURATION-PRODUCTION.md. Contrôle : php artisan production:verifier

APP_NAME="Via Experts"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                              # php artisan key:generate (UNE seule fois)
APP_URL=https://api.votre-domaine

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=                              # fourni par LWS
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Frontend (SPA) : origine EXACTE, sans chemin ni "/" final
FRONTEND_URL=https://app.votre-domaine
SANCTUM_STATEFUL_DOMAINS=app.votre-domaine
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.votre-domaine         # vide si le frontend et l'API sont sur le même hôte
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Emails (réinitialisation du mot de passe) — jamais "log" en production
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine
MAIL_FROM_NAME="${APP_NAME}"

# Sécurité HTTP (valeurs par défaut — à ne définir que pour les changer)
# TRUSTED_PROXIES=                    # vide sauf derrière un proxy/CDN connu
# SECURITY_HEADERS_ENABLED=true
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=31536000

# Premier administrateur : à définir UNIQUEMENT le temps de "php artisan db:seed --force", puis À RETIRER
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
