="1.44" fill="#fff"/><rect x="28.32" y="813.6" width="538.68" height="1.44" fill="#000"/><rect x="569.88" y="813.6" width="1.44" height="4.32" fill="#000"/><rect x="567" y="816.48" width="4.32" height="1.44" fill="#000"/><rect x="568.44" y="813.6" width="1.44" height="2.88" fill="#fff"/><rect x="567" y="815.04" width="2.88" height="1.44" fill="#fff"/><rect x="567" y="813.6" width="1.44" height="1.44" fill="#000"/><rect x="567" y="813.6" width="1.44" height="1.44" fill="#000"/></svg>
    </section></div>"
