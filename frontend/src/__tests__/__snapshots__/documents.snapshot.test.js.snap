        <thead><tr>
          <th>Désignation</th><th class="num">PU HT</th><th class="num">Qte</th><th class="num">Total HT</th>
          <th class="num">Remise</th><th class="num">Net HT</th><th class="num">TVA</th><th class="num">Total TTC</th>
