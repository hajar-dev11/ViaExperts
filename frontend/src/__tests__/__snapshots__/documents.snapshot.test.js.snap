  .pr-edit [data-champ] { background: #fff066; }
  .pr-edit [contenteditable] { outline: none; cursor: text; }
  .pr-edit .pr-b:hover { box-shadow: 0 0 0 1px rgba(184, 163, 0, 0.45); }
  .pr-edit .pr-b:focus { box-shadow: 0 0 0 2px #b8a300; }
",
